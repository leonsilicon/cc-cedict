{
  "name": "@leonsilicon/cc-cedict",
  "version": "0.0.0",
  "description": "CC-CEDICT (Chinese-English dictionary) parsed as JSON, with the Ohm grammar used to produce it.",
  "keywords": [
    "cc-cedict",
    "cedict",
    "chinese",
    "chinese-english",
    "dictionary",
    "mdbg",
    "ohm",
    "pinyin"
  ],
  "homepage": "https://github.com/leonsilicon/cc-edict#readme",
  "bugs": {
    "url": "https://github.com/leonsilicon/cc-edict/issues"
  },
  "license": "MIT",
  "author": "Leon Si <leon@leonsilicon.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonsilicon/cc-edict.git"
  },
  "files": [
    "dist",
    "index.js",
    "index.d.ts",
    "cedict_1_0_ts_utf-8_mdbg.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json",
    "./grammar": {
      "types": "./dist/grammar.d.mts",
      "import": "./dist/grammar.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run download && vp run parse && vp run build",
    "prepare": "vp config",
    "download": "curl -sL https://www.mdbg.net/chinese/export/cedict/cedict_1_0_ts_utf-8_mdbg.txt.gz | gunzip -c > data/cedict_1_0_ts_utf-8_mdbg.txt",
    "parse": "bun scripts/parse.ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "es-main": "^1.4.0",
    "ohm-js": "^17.5.0",
    "typescript": "^6.0.3",
    "unplugin-raw": "^0.7.0",
    "vite-plus": "^0.1.20"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "bun@1.3.14"
}
